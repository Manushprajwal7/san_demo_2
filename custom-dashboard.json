{
  "dashboard": {
    "title": "Next.js Application Dashboard",
    "panels": [
      {
        "id": 1,
        "title": "Application Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "up{job=\"nextjs-app\"}",
          "legendFormat": "{{instance}}"
        }],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "DOWN", "color": "red"},
                  "1": {"text": "UP", "color": "green"}
                }
              }
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Memory Usage (MB)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [{
          "expr": "process_resident_memory_bytes{job=\"nextjs-app\"} / 1024 / 1024",
          "legendFormat": "Memory"
        }],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1024,
            "unit": "bytes",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 512},
                {"color": "red", "value": 768}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "CPU Usage %",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [{
          "expr": "rate(process_cpu_seconds_total{job=\"nextjs-app\"}[1m]) * 100",
          "legendFormat": "CPU %"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 4,
        "title": "Event Loop Lag (ms)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "nodejs_eventloop_lag_seconds{job=\"nextjs-app\"} * 1000",
            "legendFormat": "Current"
          },
          {
            "expr": "nodejs_eventloop_lag_p95_seconds{job=\"nextjs-app\"} * 1000",
            "legendFormat": "P95"
          },
          {
            "expr": "nodejs_eventloop_lag_p99_seconds{job=\"nextjs-app\"} * 1000",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 5,
        "title": "Heap Memory (MB)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "nodejs_heap_size_used_bytes{job=\"nextjs-app\"} / 1024 / 1024",
            "legendFormat": "Used"
          },
          {
            "expr": "nodejs_heap_size_total_bytes{job=\"nextjs-app\"} / 1024 / 1024",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 6,
        "title": "Active Resources",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "nodejs_active_resources_total{job=\"nextjs-app\"}",
            "legendFormat": "Total Resources"
          },
          {
            "expr": "nodejs_active_handles_total{job=\"nextjs-app\"}",
            "legendFormat": "Total Handles"
          }
        ]
      },
      {
        "id": 7,
        "title": "GC Duration (ms/s)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(nodejs_gc_duration_seconds_sum{job=\"nextjs-app\", kind=\"minor\"}[5m]) * 1000",
            "legendFormat": "Minor GC"
          },
          {
            "expr": "rate(nodejs_gc_duration_seconds_sum{job=\"nextjs-app\", kind=\"major\"}[5m]) * 1000",
            "legendFormat": "Major GC"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 8,
        "title": "HTTP Requests (if available)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [{
          "expr": "rate(http_requests_total{job=\"nextjs-app\"}[5m])",
          "legendFormat": "Requests/s"
        }]
      }
    ],
    "refresh": "5s",
    "time": {"from": "now-15m", "to": "now"}
  },
  "overwrite": true
}